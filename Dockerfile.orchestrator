# syntax=docker/dockerfile:1
# Control plane for the training configuration page. Training itself uses the
# pytorch image in Dockerfile; this container only talks to the host Docker socket.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar \
    && arch="$(uname -m)" \
    && curl -fsSL "https://download.docker.com/linux/static/stable/${arch}/docker-27.5.1.tgz" -o /tmp/docker.tgz \
    && tar -xzf /tmp/docker.tgz -C /tmp \
    && mv /tmp/docker/docker /usr/local/bin/docker \
    && rm -rf /tmp/docker /tmp/docker.tgz /var/lib/apt/lists/*

# Back the EDA tab's per-dataset metrics/plots/PCA/t-SNE (orchestrator/insights.py),
# ported from ~/Documents/MLOPS/EDA4ImageClassification. Kept separate from the
# training image's deps.
RUN pip install --no-cache-dir numpy==1.26.4 Pillow==10.4.0 scikit-learn==1.5.2 \
    matplotlib==3.9.2 seaborn==0.13.2

WORKDIR /app
COPY orchestrator /app/orchestrator
COPY derms/config.py /app/derms/config.py

ENV PYTHONPATH=/app \
    ORCHESTRATOR_IN_DOCKER=1 \
    SCAN_DATASETS=/data/datasets \
    SCAN_RESULTS=/data/results \
    JOBS_DIR=/data/results/orchestrator \
    DERMS_IMAGE=derms-r-train:latest \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 8080
CMD ["python", "-m", "orchestrator"]
