# syntax=docker/dockerfile:1
#
# Blackwell (RTX 5090, sm_120) training image. The repo's root ../../Dockerfile
# is pinned to pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime, which does NOT
# include sm_120 kernels and will not run on an RTX 5090 (same class of
# mismatch already noted for Blackwell vs. the Ada-generation image). This
# file swaps only the base image; everything else is identical to the root
# Dockerfile on purpose, so both images stay behaviorally identical except
# for the CUDA/PyTorch build they carry.
#
# VERIFY BEFORE TRUSTING THIS TAG: base-image availability and Blackwell
# kernel coverage move faster than this file does. Before building for real,
# confirm the tag below exists and actually supports sm_120:
#   docker run --rm --gpus all <tag> python -c \
#     "import torch; print(torch.__version__, torch.cuda.get_arch_list()); \
#      print(torch.cuda.get_device_capability(0))"
# Expect a 'sm_120' entry (or 'compute_120') in get_arch_list() and (12, 0)
# from get_device_capability(). If this tag doesn't exist yet or lacks sm_120,
# use an NVIDIA NGC PyTorch container instead (nvcr.io/nvidia/pytorch:<tag>),
# which generally carries Blackwell support earlier than community wheels.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

ENV NO_ALBUMENTATIONS_UPDATE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# requirements.txt pins torch to ">=2.0.1,<3" (unpinned exact version) for
# exactly this reason: pip will see the base image's torch/torchvision already
# satisfy that range and will not clobber the Blackwell-capable build with a
# cu121 wheel from PyPI.
COPY requirements.txt requirements_export.txt ./
RUN pip install -r requirements.txt -r requirements_export.txt

COPY . .

RUN mkdir -p datasets results
VOLUME ["/workspace/datasets", "/workspace/results"]

ENTRYPOINT ["python"]
CMD ["train.py", "--verify-models"]
