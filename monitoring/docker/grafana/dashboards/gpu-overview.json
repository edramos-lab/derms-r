      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            },
            "pointSize": 3
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_MEM_COPY_UTIL",
          "legendFormat": "{{Hostname}} GPU{{gpu}} ({{modelName}})",
          "refId": "A"
        }
      ]
    }
  ]
}